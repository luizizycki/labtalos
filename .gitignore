# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Talos configs (Não queremos vazar certificados e kuneconfigs)
controlplane.yaml
worker.yaml
talosconfig
kubeconfig
*.kubeconfig
PLAN.md

# Chaves criptográficas
*.pem
*.key

# Direnv (variáveis de ambiente do Proxmox)
.envrc
