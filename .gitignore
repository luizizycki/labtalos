# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*


# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Generated files
generated/*
!generated/cilium.yaml
kubeconfig
talosconfig
*.kubeconfig

# Chaves criptográficas
*.pem
*.key

# Direnv (variáveis de ambiente do Proxmox)
.envrc

# Diagnostic support bundles
support.zip
support_*.zip

# Planos de trabalho
PLANO.md

# Helm values locais (contêm segredos)
helm-values/*.local.yaml

# Documentação gerada localmente
DOCS/

# Configs OCI (contêm chaves privadas WG)
oci/
